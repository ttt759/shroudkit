    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.51.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3"
  }
